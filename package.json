{
  "name": "@loopback/odata",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts",
    "bench:large": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=crud,apply-executor,batch,media,media-write --iterations=10 --warmup=2 --dataset-scale=10000",
    "bench:postgres:apply": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=apply,apply-postgres --iterations=20 --warmup=5 --dataset-scale=1000 --database=postgres",
    "bench:postgres:large": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=crud,apply-postgres,batch,media,media-write --iterations=10 --warmup=2 --dataset-scale=10000 --database=postgres",
    "bench:postgres:payload": "ts-node --project tsconfig.bench.json benchmarks/run-media-large-external.ts --dataset-scale=500 --payload-bytes=115343360",
    "bench:smoke": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=tokens --iterations=3 --warmup=1 --token-ops=1000",
    "bench:smoke:server": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=crud,apply,apply-executor,batch,media,media-write --iterations=3 --warmup=1 --dataset-scale=50",
    "bench:soak": "ts-node --project tsconfig.bench.json benchmarks/run-soak.ts --scenario=crud,apply,batch,media,media-write --iterations=100 --sample-every=10 --dataset-scale=1000",
    "bench:soak:gc": "node --expose-gc ./node_modules/ts-node/dist/bin.js --project tsconfig.bench.json benchmarks/run-soak.ts --scenario=crud,apply,batch,media,media-write --iterations=100 --sample-every=10 --dataset-scale=1000",
    "bench:tokens": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=tokens",
    "clean": "rimraf dist || true",
    "dev": "ts-node-dev --respawn --project tsconfig.dev.json examples/basic-app/index.ts",
    "docs:api": "typedoc",
    "test": "rimraf dist-tests || true && tsc -p tsconfig.test.json && mocha --exit \"dist-tests/src/__tests__/**/*.spec.js\" \"dist-tests/src/__tests__/**/*.acceptance.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "migrate": "ts-node ./examples/basic-app/migrations/migrate.ts",
    "prepack": "npm run clean && npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18 <21"
  },
  "keywords": [],
  "author": "Artiom Sargesjan",
  "license": "MIT",
  "dependencies": {
    "ipaddr.js": "^2.3.0",
    "inflection": "^3.0.2",
    "odata-v4-parser": "^0.1.29",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@loopback/boot": "^8.0.5",
    "@loopback/core": "^7.0.4",
    "@loopback/repository": "^8.0.4",
    "@loopback/rest": "^15.0.5"
  },
  "devDependencies": {
    "@loopback/boot": "^8.0.5",
    "@loopback/core": "^7.0.4",
    "@loopback/repository": "^8.0.4",
    "@loopback/rest": "^15.0.5",
    "@loopback/eslint-config": "^16.0.1",
    "@loopback/testlab": "^8.0.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.5.2",
    "eslint": "^8.57.0",
    "loopback-connector-postgresql": "^8.0.2",
    "mocha": "^11.7.2",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.2"
  }
}
