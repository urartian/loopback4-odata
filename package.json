{
  "name": "@urartian/loopback4-odata",
  "description": "LoopBack 4 extension that adds OData protocol support with decorators, generated CRUD routes, and PostgreSQL-focused production guidance.",
  "version": "1.0.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts",
    "bench:large": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=crud,apply-executor,batch,media,media-write --iterations=10 --warmup=2 --dataset-scale=10000",
    "bench:postgres:apply": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=apply,apply-postgres --iterations=20 --warmup=5 --dataset-scale=1000 --database=postgres",
    "bench:postgres:concurrency": "ts-node --project tsconfig.bench.json benchmarks/run-concurrency.ts --iterations=5 --warmup=1 --dataset-scale=10000 --concurrency=100 --database=postgres",
    "bench:postgres:large": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=crud,apply-postgres,batch,media,media-write --iterations=10 --warmup=2 --dataset-scale=10000 --database=postgres",
    "bench:postgres:million": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=crud,apply-postgres,batch --iterations=1 --warmup=0 --dataset-scale=1000000 --database=postgres",
    "bench:postgres:payload": "ts-node --project tsconfig.bench.json benchmarks/run-media-large-external.ts --dataset-scale=500 --payload-bytes=115343360",
    "bench:smoke": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=tokens --iterations=3 --warmup=1 --token-ops=1000",
    "bench:smoke:server": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=crud,apply,apply-executor,batch,media,media-write --iterations=3 --warmup=1 --dataset-scale=50",
    "bench:soak": "ts-node --project tsconfig.bench.json benchmarks/run-soak.ts --scenario=crud,apply,batch,media,media-write --iterations=100 --sample-every=10 --dataset-scale=1000",
    "bench:soak:gc": "node --expose-gc ./node_modules/ts-node/dist/bin.js --project tsconfig.bench.json benchmarks/run-soak.ts --scenario=crud,apply,batch,media,media-write --iterations=100 --sample-every=10 --dataset-scale=1000",
    "bench:tokens": "ts-node --project tsconfig.bench.json benchmarks/run-bench.ts --scenario=tokens",
    "clean": "rimraf dist || true",
    "dev": "ts-node-dev --respawn --project tsconfig.dev.json examples/basic-app/index.ts",
    "docs:api": "typedoc",
    "test": "rimraf dist-tests || true && tsc -p tsconfig.test.json && mocha --exit \"dist-tests/src/__tests__/**/*.spec.js\" \"dist-tests/src/__tests__/**/*.acceptance.js\"",
    "test:unit": "rimraf dist-tests || true && tsc -p tsconfig.test.json && mocha --exit \"dist-tests/src/__tests__/**/*.spec.js\"",
    "test:acceptance": "rimraf dist-tests || true && tsc -p tsconfig.test.json && mocha --exit \"dist-tests/src/__tests__/**/*.acceptance.js\"",
    "test:coverage": "rimraf coverage dist-tests || true && tsc -p tsconfig.test.json && c8 --all --src src --exclude \"src/__tests__/**\" --exclude \"src/types/**/*.d.ts\" --exclude \"examples/**\" --exclude \"benchmarks/**\" --reporter=text --reporter=lcov mocha --exit \"dist-tests/src/__tests__/**/*.spec.js\" \"dist-tests/src/__tests__/**/*.acceptance.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "migrate": "ts-node ./examples/basic-app/migrations/migrate.ts",
    "prepack": "npm run clean && npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "keywords": [
    "loopback4",
    "loopback",
    "odata",
    "postgresql",
    "typescript"
  ],
  "author": "Urartian LLC",
  "license": "MIT",
  "homepage": "https://github.com/urartian/loopback4-odata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urartian/loopback4-odata.git"
  },
  "bugs": {
    "url": "https://github.com/urartian/loopback4-odata/issues"
  },
  "dependencies": {
    "ipaddr.js": "^2.3.0",
    "inflection": "^3.0.2",
    "odata-v4-parser": "^0.1.29",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@loopback/boot": "^8.0.11",
    "@loopback/core": "^7.0.10",
    "@loopback/repository": "^8.0.10",
    "@loopback/rest": "^15.0.11"
  },
  "devDependencies": {
    "@loopback/boot": "^8.0.11",
    "@loopback/core": "^7.0.10",
    "@loopback/repository": "^8.0.10",
    "@loopback/rest": "^15.0.11",
    "@loopback/eslint-config": "^16.0.1",
    "@loopback/testlab": "^8.0.10",
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.12.2",
    "c8": "^10.1.3",
    "eslint": "^8.57.0",
    "loopback-connector-postgresql": "^8.0.7",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3"
  }
}
